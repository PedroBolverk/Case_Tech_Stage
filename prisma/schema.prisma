generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Area {
  id          String    @id @default(cuid())
  name        String
  description String?
  processes   Process[] // Uma área pode ter muitos processos
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Role {
  ADMIN
  USER
  GUEST
}

model Person {
  id        String    @id @default(cuid())
  name      String
  email     String?   @unique
  password  String?
  role      Role      @default(USER)
  processes Process[] // Uma pessoa pode ser responsável por muitos processos
}

model Tool {
  id     String          @id @default(cuid())
  name   String
  type   ToolType
  url    String?
  usedIn ToolOnProcess[] // Ferramentas associadas aos processos
}

model Process {
  id            String          @id @default(cuid())
  areaId        String
  area          Area            @relation(fields: [areaId], references: [id])
  title         String
  description   String?
  status        ProcessStatus   @default(PLANNED)
  importance    Int             @default(0)
  responsibleId String?         // Responsável pelo processo
  responsible   Person?         @relation(fields: [responsibleId], references: [id])
  tools         ToolOnProcess[] // Ferramentas associadas ao processo
  documents     Document[]      // Documentos associados ao processo
  subprocesses  Subprocess[]    // Subprocessos associados a esse processo
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ToolOnProcess {
  processId String
  toolId    String
  notes     String?
  process   Process @relation(fields: [processId], references: [id])
  tool      Tool    @relation(fields: [toolId], references: [id])

  @@id([processId, toolId]) // Chave composta entre processo e ferramenta
}

model Document {
  id        String  @id @default(cuid())
  processId String
  title     String
  url       String
  process   Process @relation(fields: [processId], references: [id]) // Relaciona com o processo
}

model Subprocess {
  id          String      @id @default(cuid())
  title       String
  status      ProcessStatus
  processId   String      // Chave estrangeira referindo o processo pai
  process     Process     @relation(fields: [processId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum ToolType {
  SYSTEMIC
  MANUAL
}

enum ProcessStatus {
  PLANNED
  ACTIVE
  BLOCKED
  DONE
}
